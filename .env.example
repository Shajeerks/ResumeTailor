# Normally you never edit this: use the Settings page in the app.
# AI_PROVIDER: demo | gemini | anthropic | ollama
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
# Port 3020 avoids your other apps on 3000 and 3010
PORT=3020
# 0.0.0.0 lets others on the same Wi-Fi open the app; use 127.0.0.1 for this computer only
HOST=0.0.0.0
